<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F4EA" android:keepScreenOn="true">
 <LinearLayout android:id="@+id/homeScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garry &amp; Karen" android:textColor="#12285C" android:textStyle="bold" android:textSize="38sp" android:gravity="center"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OUR WEDDING GUESTBOOK  •  30 DECEMBER 2026" android:textColor="#A9842F" android:textSize="16sp" android:gravity="center" android:paddingBottom="8dp"/>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="112dp" android:fillViewport="true" android:background="#12285C"><LinearLayout android:id="@+id/thumbStrip" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp"/></HorizontalScrollView>
  <TextView android:id="@+id/emptyHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your guestbook entries will appear above — tap any thumbnail to view it." android:textColor="#6E6E6E" android:textSize="16sp" android:gravity="center" android:padding="16dp"/>
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Leave us a photograph and a message to remember our day ♥" android:textColor="#12285C" android:textSize="24sp" android:gravity="center" android:padding="15dp"/>
  <Button android:id="@+id/addEntry" android:layout_width="360dp" android:layout_height="76dp" android:layout_gravity="center" android:text="📸  ADD TO OUR GUESTBOOK" android:textColor="#FFFFFF" android:textSize="21sp" android:backgroundTint="#12285C"/>
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/cameraScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smile! ♥" android:textColor="#12285C" android:textSize="28sp" android:textStyle="bold" android:gravity="center"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/gold_frame" android:padding="5dp"><androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent"/><ImageView android:id="@+id/photoPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/><TextView android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#F3D982" android:textSize="120sp" android:textStyle="bold" android:visibility="gone"/><View android:id="@+id/flash" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:alpha="0" android:visibility="gone"/></FrameLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="82dp"><LinearLayout android:id="@+id/cameraControls" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"><Button android:id="@+id/takePhoto" android:layout_width="300dp" android:layout_height="64dp" android:text="TAKE PHOTO" android:textColor="#FFFFFF" android:textSize="21sp" android:backgroundTint="#12285C"/></LinearLayout><LinearLayout android:id="@+id/reviewControls" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone"><Button android:id="@+id/retake" android:layout_width="220dp" android:layout_height="62dp" android:text="RETAKE"/><Space android:layout_width="28dp" android:layout_height="1dp"/><Button android:id="@+id/keep" android:layout_width="260dp" android:layout_height="62dp" android:text="USE THIS PHOTO" android:textColor="#FFFFFF" android:backgroundTint="#12285C"/></LinearLayout></FrameLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/writeScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="14dp" android:visibility="gone">
  <ImageView android:id="@+id/entryPhoto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.43" android:scaleType="centerCrop" android:layout_marginEnd="12dp"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.57" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Write us a message…" android:textColor="#12285C" android:textSize="27sp" android:textStyle="bold" android:gravity="center"/><EditText android:id="@+id/guestNames" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Your name(s)" android:textSize="20sp" android:singleLine="true"/>
   <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/gold_frame" android:padding="4dp"><uk.co.gmillns.pad13photobooth.DrawingView android:id="@+id/drawing" android:layout_width="match_parent" android:layout_height="match_parent"/><EditText android:id="@+id/typedMessage" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top" android:padding="20dp" android:hint="Type your message here…" android:textSize="22sp" android:background="#FFFDF7" android:visibility="gone"/></FrameLayout>
   <HorizontalScrollView android:layout_width="match_parent" android:layout_height="70dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center"><Button android:id="@+id/pen" android:layout_width="110dp" android:layout_height="54dp" android:text="✍ PEN"/><Button android:id="@+id/eraser" android:layout_width="120dp" android:layout_height="54dp" android:text="ERASER"/><Button android:id="@+id/undo" android:layout_width="110dp" android:layout_height="54dp" android:text="UNDO"/><Button android:id="@+id/clear" android:layout_width="110dp" android:layout_height="54dp" android:text="CLEAR"/><Button android:id="@+id/typeToggle" android:layout_width="150dp" android:layout_height="54dp" android:text="TYPE / WRITE"/></LinearLayout></HorizontalScrollView>
   <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center"><Button android:id="@+id/cancelEntry" android:layout_width="180dp" android:layout_height="58dp" android:text="CANCEL"/><Space android:layout_width="20dp" android:layout_height="1dp"/><Button android:id="@+id/saveEntry" android:layout_width="280dp" android:layout_height="58dp" android:text="SAVE TO GUESTBOOK ♥" android:textColor="#FFFFFF" android:backgroundTint="#12285C"/></LinearLayout>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/viewerScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:visibility="gone"><ImageView android:id="@+id/viewerImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter"/><LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center"><Button android:id="@+id/prevEntry" android:layout_width="180dp" android:layout_height="56dp" android:text="◀ PREVIOUS"/><Space android:layout_width="20dp" android:layout_height="1dp"/><Button android:id="@+id/viewerBack" android:layout_width="230dp" android:layout_height="56dp" android:text="BACK TO GUESTBOOK" android:textColor="#FFFFFF" android:backgroundTint="#12285C"/><Space android:layout_width="20dp" android:layout_height="1dp"/><Button android:id="@+id/nextEntry" android:layout_width="180dp" android:layout_height="56dp" android:text="NEXT ▶"/></LinearLayout></LinearLayout>
 <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" android:background="#DD12285C" android:visibility="gone"/>
</FrameLayout>
